DATABASE_URL="mysql://root:@localhost:3306/salestracking_db"
PORT=3000

# --- Runtime ---
NODE_ENV=development
# isi 1 bila berjalan di belakang reverse proxy (agar rate limit membaca IP asli)
TRUST_PROXY=0

# --- Auth ---
# WAJIB diisi: hex 64 karakter (32 byte). Generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=be-ab-medical
JWT_AUDIENCE=ab-medical-web

# Format durasi: 15m, 12h, 7d. Harus ACCESS < REFRESH <= SESSION_MAX_AGE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SESSION_MAX_AGE=30d

# --- Rate limit login ---
LOGIN_RATE_WINDOW=15m
LOGIN_RATE_MAX=10

# --- Password hashing ---
# bcryptjs (pure JS) memerlukan ~1.2 detik per operasi di cost 12.
# Turunkan ke 10 (~0.33 detik) bila terlalu lambat untuk mesin Anda.
BCRYPT_COST=12

# --- CORS ---
# Origin frontend yang diizinkan (boleh lebih dari satu, dipisah koma)
CORS_ORIGIN=http://localhost:5173
